# Client data: never commit raw exports (even in a private repo).
# Everything under data/ is ignored; only the folder .gitkeep files
# are tracked.
data/**
!data/*/
!data/*/.gitkeep

# Data exports anywhere in the repo
*.csv
*.tsv
*.xlsx
*.xls
*.parquet

# Secrets and credentials
.env
*.env
*.key
*.pem
secrets/
credentials*.json
token*.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/
.idea/

# Review results/ before every commit: they must not contain account IDs,
# client names or anything the owner has not approved.

# Local outputs and working folders: never commit (T0c)
outputs/
config/local/
data/interim/
notebooks/
evidence/

# Local scratch files and copies (not part of the project)
/campaign-compass/
/pr*-diff.txt
/Logo-*.png
/assets/logo.png
